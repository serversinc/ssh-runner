{
    "name": "serversinc/ssh-runner",
    "version": "0.2.1",
    "description": "Actions-based SSH Runner",
    "keywords": [
        "serversinc",
        "ssh-runner"
    ],
    "homepage": "https://github.com/serversinc/ssh-runner",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Max Diamond",
            "email": "hello@maxdiamond.co.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "spatie/ssh": "^1.13"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.0|^10.5|^11.0",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Serversinc\\SshRunner\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Serversinc\\SshRunner\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"

    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Serversinc\\SshRunner\\SshRunnerServiceProvider"
            ],
            "aliases": {
                "SshRunner": "Serversinc\\SshRunner\\Facades\\SshRunner"
            }
        }
    }
}
